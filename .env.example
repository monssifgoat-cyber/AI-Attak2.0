# انسخ هذا الملف إلى .env واملأ القيم — لا تضع .env في git أبدًا

# مفتاح Gemini API (اختياري — فقط إن كان llm.provider = gemini في config.yaml)
GEMINI_API_KEY=

# مفتاح REST API الخاص بـ ZAP (يُستخدم أيضًا داخل docker-compose.yml)
ZAP_API_KEY=change-me-please

# كلمة مرور msfrpcd (شغّلها على مضيف Kali بالأمر:
#   msfrpcd -P <نفس-الكلمة-هنا> -S -a 127.0.0.1 -p 55553
MSF_RPC_PASSWORD=change-me-too
